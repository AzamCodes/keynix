datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model User {
  id                  String      @id @default(uuid())
  email               String      @unique
  authHash            String      @map("auth_hash")
  masterSalt          String      @map("master_salt") // Base64 16 bytes
  kdfParams           String      @map("kdf_params") // JSON stringified { algorithm, m, t, p }
  encryptedVaultKey   String      @map("encrypted_vault_key") // JSON stringified { iv, tag, ciphertext }
  recoveryEncryptedKey String?     @map("recovery_encrypted_key") // JSON stringified { iv, tag, ciphertext }
  version             Int         @default(1)
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  vaultItems          VaultItem[]
  sessions            Session[]
  auditLogs           AuditLog[]

  @@map("users")
}

model VaultItem {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  ciphertext  String   // Base64 AES-256-GCM Payload
  iv          String   // Base64 12 bytes
  tag         String   // Base64 16 bytes
  aadMeta     String   @map("aad_meta") // JSON stringified { version, itemId, userId }
  
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("vault_items")
}

model Session {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  tokenHash   String    @unique @map("token_hash") // SHA-256 hex of session token
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  eventType String   @map("event_type") // e.g. "AUTH_SUCCESS", "VAULT_SYNC"
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([eventType])
  @@map("audit_logs")
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime @map("expires_at")

  @@map("rate_limits")
}

